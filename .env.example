# Em modo Xano, defina XANO_LOGIN_URL e este endpoint juntos. Sem XANO_LOGIN_URL,
# o cadastro e o login usam o banco SQLite local (NIGHTFALL_AUTH_DB).
XANO_SIGNUP_URL=https://x8ki-letl-twmt.n7.xano.io/api:nightfall-auth/signup
XANO_PRODUCTS_URL=https://x8ki-letl-twmt.n7.xano.io/api:nightfall-auth/produto

# Login pelo Xano (endpoint login do grupo nightfall-auth). Vazio = autenticação local SQLite.
# Só preencha depois de publicar xano/nightfall-user-auth/api/nightfall_auth/login_POST.xs.
XANO_LOGIN_URL=

# Opcional: caminho persistente para o banco local de autenticação.
# Padrão: auth_users.sqlite3 na raiz do projeto.
NIGHTFALL_AUTH_DB=

# Admin verificado no servidor. Gere o hash com: python scripts/gerar_hash_admin.py
# Sem estas duas variáveis, ninguém é admin pelo .env.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD_HASH=admin123

# Use somente a chave do Asaas Sandbox durante os testes.
ASAAS_API_KEY=

# Sem ASAAS_API_KEY, o checkout usa o modo simulado em localhost. Use 0 para desligar.
NIGHTFALL_SIMULATED_PAYMENTS=1
